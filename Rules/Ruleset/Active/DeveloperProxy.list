DOMAIN,freebuff.com
DOMAIN,codebuff.com
# Observed canonical website redirect target, exact host only.
DOMAIN,www.codebuff.com

# Nous Portal account/authentication service used by Hermes Agent.
# https://github.com/NousResearch/hermes-agent/blob/main/hermes_cli/auth_nous.py
# Public portal resources favor proxies; token refresh and inference are separate checks.
DOMAIN,portal.nousresearch.com

# Hermes Agent official website, documentation and installer entry point.
# https://hermes-agent.nousresearch.com/docs/
# Repeated complete page, stylesheet and documentation-index transfers favor proxies.
DOMAIN,hermes-agent.nousresearch.com

# OpenRouter model gateway: this host serves both the website and /api/v1 APIs.
