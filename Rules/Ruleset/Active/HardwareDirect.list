# Hardware Direct

# Synology's public software download host. The 2 MiB Windows Drive Client
# EXE and MSI ranges matched between mainland China direct and Singapore proxy.
# https://archive.synology.com/download/Utility/SynologyDriveClient/4.2.1-20062
DOMAIN,global.synologydownload.com

# NVIDIA downloads. The .com host redirects mainland traffic to the .cn mirror;
# the FrameView installer ranges and the licensing PDF matched proxy downloads.
# https://www.nvidia.com/en-gb/geforce/technologies/frameview/
DOMAIN,images.nvidia.com
DOMAIN,images.nvidia.cn

# Samsung FOTA version manifest; valid XML is faster directly with a firmware-client UA.
# https://github.com/samloader/samloader/blob/master/samloader/versionfetch.py
# This exact host does not cover separate firmware binary download services.
DOMAIN,fota-cloud-dn.ospserver.net

# Bambu Studio HMS error descriptions and recovery-action dictionary.
# https://github.com/bambulab/BambuStudio/blob/master/src/slic3r/GUI/HMS.cpp
# Complete JSON transfers succeeded on both paths; direct median times were lower.
DOMAIN,e.bambulab.com

# SUNLU product and technical-information website; stable direct transfers.
# https://www.sunlu.com/support/faq
# Prefer direct for this workload's modest proxy benefit; include the observed log spelling.
DOMAIN,www.sunlu.com
DOMAIN,www\.sunlu.com

# OpenRGB website and device-support data; direct samples were consistently successful.
# Release binaries are linked to separate hosts and are not covered by this exact rule.
# https://openrgb.org/releases.html
DOMAIN,openrgb.org
# GPU / CPU vendors: updater and device service endpoints
DOMAIN,download.amd.com
DOMAIN,drivers.amd.com
DOMAIN,ftpm.amd.com
DOMAIN,www.amd.com
DOMAIN,www.asus.com
DOMAIN,dsadata.intel.com
DOMAIN,ops-gx.nvidia.com

# GIGABYTE static product resources
DOMAIN,static.gigabyte.com

# Third-party hardware community downloads (vGPU drivers and documentation)
DOMAIN,alist.homelabproject.cc
